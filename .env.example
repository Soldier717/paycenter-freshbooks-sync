# --- Priority Pay Center (Hyfin) ---
PAYCENTER_BASE_URL=https://stage-api.paycenter.app
PAYCENTER_SITE_ID=69a73edc717beada3d3f1a83
PAYCENTER_ACCESS_TOKEN=            # the x_access_token. Never commit this.
# link     = nobody is contacted; Pay Center returns a pay link that we store (default)
# customer = Pay Center texts/emails the payment request to the FreshBooks client
PAYCENTER_NOTIFY_MODE=link
# Long random string. It is part of the webhook URL Pay Center calls.
PAYCENTER_WEBHOOK_SECRET=

# --- FreshBooks developer app ---
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
# The one FreshBooks account this service may read and write. Use a TEST account first.
FRESHBOOKS_ACCOUNT_ID=

# --- This service ---
APP_URL=https://your-deployment.vercel.app
ADMIN_SECRET=                      # protects the setup routes
CRON_SECRET=                       # Vercel sends this to the daily reconcile job
# settled  = post a payment to FreshBooks only once it settles (default)
# captured = post as soon as it is approved/submitted
RECORD_ON=settled
# review = returns, voids, chargebacks and refunds wait for a person (default)
# auto   = the FreshBooks payment is removed or reduced automatically
REVERSALS=review

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
