# --- This service ---
APP_URL=https://paycenter-freshbooks-sync.vercel.app
ADMIN_SECRET=            # sign-in password for /admin and the JSON routes
CRON_SECRET=             # Vercel sends this to the daily reconcile job
DATA_KEY=                # 64 hex chars; encrypts merchant tokens at rest (openssl rand -hex 32)

# --- FreshBooks developer app (one app, owned by PBS; every merchant approves it) ---
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Per-merchant settings (Pay Center site, token, FreshBooks account, rules) live in the
# merchants table and are managed at /admin. No merchant values belong here.
